{
  "name": "@spotzee/api-schemas",
  "version": "0.2.1",
  "private": true,
  "description": "Shared Zod + OpenAPI schemas for the Spotzee Main API and Extended API.",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js"
    },
    "./shared": {
      "types": "./dist/esm/shared/index.d.ts",
      "import": "./dist/esm/shared/index.js",
      "require": "./dist/cjs/shared/index.js"
    },
    "./main": {
      "types": "./dist/esm/main/index.d.ts",
      "import": "./dist/esm/main/index.js",
      "require": "./dist/cjs/main/index.js"
    },
    "./extended": {
      "types": "./dist/esm/extended/index.d.ts",
      "import": "./dist/esm/extended/index.js",
      "require": "./dist/cjs/extended/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "npm run clean && npm run build:esm && npm run build:cjs && npm run build:fixup",
    "build:esm": "tsc -p tsconfig.esm.json",
    "build:cjs": "tsc -p tsconfig.cjs.json",
    "build:fixup": "node scripts/write-dist-package-json.js",
    "test": "npm run build && node --test test/*.test.js",
    "typecheck": "tsc -p tsconfig.esm.json --noEmit",
    "clean": "rm -rf dist"
  },
  "peerDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "typescript": "^5.4.0",
    "zod": "^3.25.76"
  }
}
